# ================================
# HARISENIN COURSE PLATFORM CONFIG
# ================================

# MockAPI Configuration
# Replace with your own MockAPI endpoint
VITE_API_BASE_URL=https://your-mockapi-id.mockapi.io/api/v1

# Application Configuration
VITE_APP_NAME=Harisenin Course Platform
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Platform pembelajaran online dengan React + TypeScript

# Development Configuration
VITE_NODE_ENV=development
VITE_DEBUG_MODE=true

# ================================
# SETUP INSTRUCTIONS
# ================================
# 1. Copy this file to .env in the root directory
# 2. Replace VITE_API_BASE_URL with your actual MockAPI URL
# 3. Get your MockAPI URL from: https://mockapi.io/
# 4. Create endpoints: /users and /course
# 5. Never commit .env file to version control
# 
# Example MockAPI structure:
# - Users endpoint: /users (id, createdAt, userEmail, userPassword, userGender, userPhoneNumber)
# - Course endpoint: /course (id, createdAt, courseName, courseIntructorName, courseImage, coursePrice, courseInstructorJob, courseInstructorJobDetail)
#
# Note: If VITE_API_BASE_URL is not set, the app will fallback to the default URL